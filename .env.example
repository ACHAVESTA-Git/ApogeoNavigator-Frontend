# Base de la API. Vacía = mismo origen (rutas relativas /api/...). Sin barra final.
# Ejemplo: VITE_API_BASE_URL=https://apogeo-backend-dev-xxxx.a.run.app
VITE_API_BASE_URL=

# Datos de ejemplo: auto (API primero; muestra solo si la API no responde), true (siempre muestra) o false (solo API).
VITE_USE_SAMPLE_DATA=auto

# Todas las variables VITE_* son públicas: aquí nunca van secretos (la clave de carga se pide en el popup).
